#!/usr/bin/env bash
# A private, bounded live Crew workload; see notes/prompt-cache/bench.md.
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1
cache_script_dir=$(cd "$(dirname "$0")" && pwd)
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$cache_script_dir/bench.py" "$@"
fi
if command -v nix >/dev/null 2>&1; then
    exec nix shell nixpkgs#python3 --command python3 "$cache_script_dir/bench.py" "$@"
fi
echo 'cache bench needs Python 3.11 or newer (or Nix)' >&2
exit 2
