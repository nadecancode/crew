          {
            "id": "member",
            "toolbox": {
              "include": [
                "missing"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "unmatched-exclusion",
      "stage": "core",
      "field": "agents[0].toolbox.exclude[0]",
