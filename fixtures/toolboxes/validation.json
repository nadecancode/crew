        "project": "invalid-toolbox",
        "agents": [
          {
            "id": "member",
            "toolbox": {
              "exclude": [
                "mcp.missing"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "duplicate-exclusion",
      "stage": "core",
      "field": "agents[0].toolbox.exclude[1]",
      "team": {
        "project": "invalid-toolbox",
        "agents": [
          {
            "id": "member",
            "toolbox": {
              "include": [
                "base"
              ],
              "exclude": [
                "mcp.context7",
                "mcp.context7"
              ]
            }
          }
        ],
        "toolboxes": {
          "base": {
            "mcp": {
              "context7": {
                "command": [
                  "@PYTHON@",
                  "@ROOT@/mcp_stub.py"
                ],
                "cwd": ".",
                "env": {
                  "FIXTURE_PUBLIC": {
                    "value": "public-fixture-value"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "own-excluded-item",
      "stage": "core",
      "field": "agents[0].toolbox.exclude[0]",
      "team": {
        "project": "invalid-toolbox",
        "agents": [
          {
            "id": "member",
            "toolbox": {
              "mcp": {
                "example": {
                  "command": [
                    "@PYTHON@",
                    "@ROOT@/mcp_stub.py"
                  ]
                }
              },
              "exclude": [
                "mcp.example"
              ]
            }
          }
        ]
      }
    },
    {
